# ===== Required =====
DISCORD_TOKEN=your-bot-token-here
ODDS_API_KEY=your-odds-api-key
# Backup key, used automatically when the first one runs out (leave blank if none)
ODDS_API_KEY_2=
GEMINI_API_KEY=your-gemini-api-key

# ===== Discord =====
# compact = one message per scan (pick details in a dropdown); full = one message per pick
LINEMAKER_CARD_STYLE=compact
LINEMAKER_HOME_CHANNEL=1562390542128648202
LINEMAKER_GUILD_ID=
LINEMAKER_CHAT_CHANNELS=
# Daily automatic post: costs one scan per league per day, so it's off unless a time is set
# (e.g. 17:30, after props are posted). Channel blank = the home channel.
LINEMAKER_CHANNEL_ID=
LINEMAKER_POST_TIME=
LINEMAKER_SPORTS=NBA,NFL,NHL
LINEMAKER_TZ=America/New_York

# ===== Chat AI =====
LINEMAKER_AI=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash
GEMINI_THINKING=low
GEMINI_TIMEOUT=45
LINEMAKER_CHAT_TIMEOUT=240
# Only if you switch LINEMAKER_AI to claude
ANTHROPIC_API_KEY=
LINEMAKER_MODEL=claude-opus-5-5
LINEMAKER_EFFORT=medium

# ===== Projections =====
# auto = FantasyPros, switching to the free ESPN model on sample data; or espn / fantasypros
LINEMAKER_PROJECTIONS=auto
FANTASYPROS_API_KEY=
# Game-line model: how much Kalshi's win probability counts vs ESPN team ratings (0-1)
LINEMAKER_KALSHI_WEIGHT=0.4

# ===== Odds and books =====
LINEMAKER_BET_BOOKS=FanDuel,DraftKings
# Books read for the market consensus (up to 10 cost the same as one region). Pinnacle is an
# EU book, so it's only included when listed here; it posts game lines, not player props.
ODDS_API_BOOKMAKERS=fanduel,draftkings,pinnacle,betmgm,williamhill_us,fanatics,betrivers,bovada,betonlineag,lowvig
# Sharp books count more in the no-vig consensus (never bet there; weights, unlisted = 1)
LINEMAKER_SHARP_BOOKS=Pinnacle:3
# Alternate prop lines: about double the credits per props scan
LINEMAKER_ALT_LINES=on
# Bet buttons that open FanDuel/DraftKings with the slip loaded
LINEMAKER_BET_LINKS=on
# Your state for book links that need one (nj, pa, ny, az, ...)
LINEMAKER_STATE=
# Minutes to reuse a scan before buying fresh odds (chat, /picks, /parlay, daily post share it)
LINEMAKER_PLAYS_CACHE_MINUTES=30

# ===== Automatic scans and alerts (post in the home channel) =====
# Props for each game this many minutes before tip (lineups are in); posts only real plays.
# ~5-10 credits per game. Blank = off. Asking for a league's props ("best props nhl") also
# turns its pre-tip scans on for the rest of that day. LINEMAKER_PRETIP_SPORTS=all = every
# league, every day, without asking.
LINEMAKER_PRETIP_MINUTES=45
LINEMAKER_PRETIP_SPORTS=NBA
# Injury news: check ESPN every N minutes (free); re-price a game when a rotation player is
# newly ruled Out (basketball). ~5-10 credits per alert, capped per day. Blank = off.
LINEMAKER_NEWS_MINUTES=12
LINEMAKER_NEWS_MAX_ALERTS=8
# Weekly summary post (day 0 = Monday). Blank time = off.
LINEMAKER_WEEKLY_TIME=10:00
LINEMAKER_WEEKLY_DAY=0

# ===== Projection adjustments (basketball) =====
# Share of an Out rotation player's production handed to his teammates
LINEMAKER_USAGE_SHARE=0.6
# Games per defense used for defense-vs-position
LINEMAKER_DVP_GAMES=10

# ===== Stakes =====
# Your usual bet amounts: each pick shows one (bigger edge = bigger amount; parlays use the
# two smallest). Blank = show Kelly % instead (with LINEMAKER_BANKROLL for dollars).
LINEMAKER_STAKE_TIERS=2.5,5,10,15,20
LINEMAKER_BANKROLL=
LINEMAKER_KELLY=0.25
LINEMAKER_MAX_STAKE_PCT=2

# ===== Live (in-game) mode =====
# How much the live model counts vs the live market (the market sees possession, fouls, injuries)
LINEMAKER_LIVE_MODEL_WEIGHT=0.35
# Ignore book prices older than this many seconds
LINEMAKER_LIVE_MAX_ODDS_AGE=90
# Reuse a live pull for this many seconds (each live scan is ~3 credits per league)
LINEMAKER_LIVE_CACHE_SECONDS=60

# ===== Smart mode gates =====
LINEMAKER_ODDS_MIN=-105
LINEMAKER_ODDS_MAX=-300
LINEMAKER_MIN_PROB=
LINEMAKER_MIN_GAP=0.03
LINEMAKER_MAX_GAP=0.15
LINEMAKER_MIN_EV=0.03
LINEMAKER_HIT_RATES=on

# ===== Volume / parlay mode =====
LINEMAKER_VOLUME_MIN_PROB=0.75
LINEMAKER_VOLUME_ODDS_MIN=-200
LINEMAKER_VOLUME_ODDS_MAX=-1000
LINEMAKER_VOLUME_MIN_GAP=-0.02
LINEMAKER_VOLUME_LEGS=15

# ===== Model weights =====
# Starting weights. With auto-tuning on, the bot re-fits them after every grade and saves the
# result to tracking/weights.json (which then wins over these two lines).
LINEMAKER_MODEL_WEIGHT=0.5
LINEMAKER_FRESH_WEIGHT=0.8
LINEMAKER_AUTOTUNE=on
# Graded results needed before anything moves; most a weight can move per re-fit; days used
LINEMAKER_AUTOTUNE_MIN=200
LINEMAKER_AUTOTUNE_STEP=0.10
LINEMAKER_AUTOTUNE_DAYS=60
# Grade yesterday automatically each morning (blank = off; ~2 credits per league)
LINEMAKER_AUTOGRADE_TIME=09:30

# ===== Folders and timing =====
LINEMAKER_TRACKING_DIR=tracking
LINEMAKER_SNAPSHOTS=snapshots
LINEMAKER_CACHE_DIR=cache
LINEMAKER_SLATE_DIR=
LINEMAKER_PROJECTIONS_DIR=
LINEMAKER_FREEZE_MINUTES=30
